# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A raycasting engine in OCaml on SDL2"
description:
  "A first-person raycaster with arbitrary-angle wall segments, an inclined floor and either an inclined ceiling or an open sky, per-wall heights, textures generated in code or read from PNG and JPEG, see-through walls, wall decals, billboarded sprites, distance fog, mouse look with pitch, and a resizable/fullscreen window, built on the tsdl bindings."
maintainer: ["pharick <artemforkunov@gmail.com>"]
authors: ["pharick <artemforkunov@gmail.com>"]
license: "MIT"
homepage: "https://github.com/pharick/camlcast"
bug-reports: "https://github.com/pharick/camlcast/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.1"}
  "tsdl"
  "tsdl-image"
  "alcotest" {with-test}
  "ocaml-lsp-server" {with-dev-setup}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/pharick/camlcast.git"
x-maintenance-intent: ["(latest)"]
# Merged into the generated camlcast.opam by dune. Only fields dune does not
# produce itself belong here; everything else lives in dune-project.
#
# tsdl-image is pinned because the released 0.6 cannot be built on Windows.
# Its config/discover.ml passes `pkg-config --libs SDL2_image` through verbatim
# into (c_library_flags ...), and on mingw that inherits -mwindows from SDL2's
# own sdl2.pc, which flexlink rejects. dbuenzli's tsdl escapes this by asking
# pkg-config for --libs-only-l and --libs-only-L, whose output cannot contain it.
#
# Upstream fixed it in January 2026 by dropping the configurator entirely and
# loading SDL2_image at runtime, and shipped the same fix for tsdl-ttf as 0.7 —
# but never re-cut tsdl-image, so opam still offers 0.6 from 2023. Hence a commit
# rather than a version. Drop this once 0.6.1 or later reaches opam.
#
# The commit is February's rather than January's because the January one picks
# the library to load by matching on dune's %{system} against "win32" | "win64"
# | "cygwin" | "mingw" — and OCaml calls 64-bit mingw "mingw64", which is none
# of those. It fell through to the Linux branch, hunted for a .so, found
# nothing, and left every IMG_* symbol unresolved at runtime. February matches
# on Sys.os_type instead, so "Win32" catches it whatever the system string says.
#
# Not a version constraint in dune-project: 0.6.1 does not exist in opam, so
# constraining it there would make camlcast unresolvable for everyone else.
pin-depends: [
  [
    "tsdl-image.0.6.1"
    "git+https://github.com/sanette/tsdl-image.git#3aad0371503268a08c229d7cc34185212d3dd713"
  ]
]
