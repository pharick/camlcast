  test_color
  test_texture
  test_material
  test_atmosphere
  test_input
  test_binding
  test_key
  test_sight
  test_engine
  test_patterns
  test_pictures
  test_level
  test_demos
  test_menu)
 (libraries camlcast camlcast_demo alcotest))
