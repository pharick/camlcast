; One executable per module under test; they all share the Support fixtures
; and testables. Input (SDL owns the keyboard and mouse state), Framebuffer (a
; wrapper over an SDL texture) and Renderer (per-pixel SDL output) all need a
; live SDL surface, so their pure pieces are tested through Plane, Viewport,
; Material and Atmosphere instead.
;
; The demo's suites live here too, beside the engine's own, because they share
; these fixtures and there is no reason to run them separately. A game built on
; this engine tests itself in its own repo.

(tests
 (names
  test_vec
  test_result_ext
  test_plane
  test_sky
  test_image
  test_transform
  test_room
  test_world
  test_ray
  test_player
  test_viewport
  test_color
  test_texture
  test_material
  test_atmosphere
  test_engine
  test_patterns
  test_pictures
  test_level)
 (libraries raycaster camlcast_demo alcotest))
